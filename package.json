{
  "name": "bridget",
  "version": "v1.0.0",
  "private": true,
  "description": "bridget theme source file",
  "keywords": [
    "hugo",
    "photography",
    "sass",
    "theme",
    "typescript"
  ],
  "homepage": "https://github.com/Sped0n/bridget#readme",
  "bugs": {
    "url": "https://github.com/Sped0n/bridget/issues"
  },
  "license": "MIT",
  "author": "spedon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sped0n/bridget.git"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "test": "node --test gallery.test.mjs",
    "vite": "DISABLE_WATCH=1 vite build",
    "lint": "oxlint --fix && oxfmt --write . && pnpm run format:hugo",
    "lint:check": "oxlint --deny-warnings && oxfmt --check . && pnpm run format:hugo:check && pnpm run check:types",
    "format:hugo": "node format-hugo.mjs --write",
    "format:hugo:check": "node format-hugo.mjs --check",
    "check:types": "tsc --noEmit",
    "dev": "run-p vite:dev hugo:dev",
    "build": "run-s vite:build hugo:build",
    "server": "run-p vite:server hugo:server",
    "vite:build": "DISABLE_WATCH=1 vite build",
    "vite:server": "vite build",
    "vite:dev": "vite build --mode development --minify false",
    "hugo:build": "hugo --logLevel info --source=exampleSite --minify",
    "hugo:preview": "hugo --logLevel info --source=exampleSite -D",
    "hugo:dev": "hugo server --source=exampleSite -D --disableFastRender --watch --logLevel info",
    "hugo:server": "hugo server --source=exampleSite --disableFastRender --renderToMemory -e production --watch --logLevel info"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.15",
    "gsap": "^3.15.0",
    "solid-js": "2.0.0-rc.15"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.50",
    "@types/node": "^26.6.5",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "sass-embedded": "^1.105.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "packageManager": "pnpm@11.27.0"
}
